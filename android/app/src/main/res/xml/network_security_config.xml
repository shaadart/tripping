<?xml version="1.0" encoding="utf-8"?>
<!-- Everything stays HTTPS, except the style the app serves to MapLibre's
     offline downloader on this phone's own loopback address
     (lib/map/download_style.dart). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
