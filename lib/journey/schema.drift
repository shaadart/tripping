import 'journey.dart';

-- One recorded outing. `id` is the compact local key that track points
-- reference; `uuid` is the identity used across devices and in exports.
CREATE TABLE journeys (
  id INTEGER NOT NULL PRIMARY KEY,
  uuid TEXT NOT NULL UNIQUE,
  mode ENUMNAME(JourneyMode) NOT NULL,
  status ENUMNAME(JourneyStatus) NOT NULL,
  created_at INTEGER NOT NULL MAPPED BY `const UtcMillis()`,
  ended_at INTEGER MAPPED BY `const UtcMillis()`,
  -- A summary derived from the track, cached for the journey list (v2).
  -- NULL, or a summary_version older than the app's, means "derive again":
  -- the track is the truth.
  summary_version INTEGER,
  meters REAL,
  moving_ms INTEGER,
  recorded_ms INTEGER,
  -- JSON: per segment, a few [longitude, latitude] pairs for a thumbnail.
  outline TEXT
) AS JourneyRow;

-- At most one journey is active (recording or paused) on a device.
CREATE UNIQUE INDEX IF NOT EXISTS one_active_journey
  ON journeys (status IN ('recording', 'paused'))
  WHERE status IN ('recording', 'paused');

-- A continuous stretch of recording. Pausing or an interruption closes the
-- open segment; resuming opens the next one. Distance is never measured
-- across a segment boundary because nothing is known about the gap.
CREATE TABLE segments (
  journey_id INTEGER NOT NULL REFERENCES journeys (id) ON DELETE CASCADE,
  seq INTEGER NOT NULL,
  started_at INTEGER NOT NULL MAPPED BY `const UtcMillis()`,
  ended_at INTEGER MAPPED BY `const UtcMillis()`,
  end_reason ENUMNAME(SegmentEnd),
  PRIMARY KEY (journey_id, seq)
) AS SegmentRow;

-- Keyed by fix time, so re-delivering the same fix is a harmless no-op and
-- rows are physically ordered for range reads.
CREATE TABLE track_points (
  journey_id INTEGER NOT NULL REFERENCES journeys (id) ON DELETE CASCADE,
  time INTEGER NOT NULL MAPPED BY `const UtcMillis()`,
  segment INTEGER NOT NULL,
  latitude REAL NOT NULL,
  longitude REAL NOT NULL,
  accuracy REAL,
  altitude REAL,
  altitude_accuracy REAL,
  speed REAL,
  heading REAL,
  PRIMARY KEY (journey_id, time)
) WITHOUT ROWID AS TrackPointRow;

-- A place on a journey (v3): where the user was when they marked it, with
-- the fix it came from, or a point they chose on the map. Deleting the
-- journey deletes its waypoints.
CREATE TABLE waypoints (
  id INTEGER NOT NULL PRIMARY KEY,
  journey_id INTEGER NOT NULL REFERENCES journeys (id) ON DELETE CASCADE,
  -- Stored by name. Not ENUMNAME(WaypointKind): "WaypointKind" contains
  -- "INT", which gives the column integer affinity, and the enum would be
  -- stored by its index.
  kind TEXT NOT NULL MAPPED BY `const WaypointKindByName()`,
  created_at INTEGER NOT NULL MAPPED BY `const UtcMillis()`,
  latitude REAL NOT NULL,
  longitude REAL NOT NULL,
  -- Marked waypoints only: the fix's accuracy, altitude and GPS time.
  accuracy REAL,
  altitude REAL,
  fix_time INTEGER MAPPED BY `const UtcMillis()`,
  name TEXT,
  note TEXT
) AS WaypointRow;

CREATE INDEX IF NOT EXISTS waypoints_by_journey ON waypoints (journey_id);

-- A journey's destination and the way there (v4). Kept with the journey so
-- the route is still there without a connection or after a restart. A
-- straight line is stored as such and never shown as a road. The route
-- columns stay NULL until a way has been planned.
CREATE TABLE routes (
  journey_id INTEGER NOT NULL PRIMARY KEY
    REFERENCES journeys (id) ON DELETE CASCADE,
  destination TEXT NOT NULL,
  destination_detail TEXT,
  latitude REAL NOT NULL,
  longitude REAL NOT NULL,
  -- Stored by name (see waypoints.kind).
  kind TEXT MAPPED BY `const RouteKindByName()`,
  provider TEXT,
  computed_at INTEGER MAPPED BY `const UtcMillis()`,
  meters REAL,
  seconds REAL,
  -- The line, as a polyline with six decimals.
  geometry TEXT
) AS RouteRow;

-- Places chosen as destinations, newest first (v4). On this phone only.
CREATE TABLE recent_places (
  id INTEGER NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  detail TEXT,
  latitude REAL NOT NULL,
  longitude REAL NOT NULL,
  used_at INTEGER NOT NULL MAPPED BY `const UtcMillis()`
) AS RecentPlaceRow;

-- The group this journey belongs to (G1), stored with the journey so that
-- joining works offline. Whether anyone in it is reachable is never stored
-- here: membership is not connectivity.
CREATE TABLE memberships (
  journey_id INTEGER NOT NULL PRIMARY KEY
    REFERENCES journeys (id) ON DELETE CASCADE,
  -- The group's id: the inviting journey's uuid.
  group_id TEXT NOT NULL,
  -- The capability: whoever holds it may join. Never logged or exported.
  secret TEXT NOT NULL,
  -- Stored by name (see waypoints.kind).
  role TEXT NOT NULL MAPPED BY `const GroupRoleByName()`,
  -- Who invited, as they named themselves; null for the inviter.
  host_name TEXT,
  joined_at INTEGER NOT NULL MAPPED BY `const UtcMillis()`
) AS MembershipRow;
